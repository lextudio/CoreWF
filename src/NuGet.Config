<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="Nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
    <!-- The OpenDevelop addin under src/OpenDevelop.AddIn builds against OpenDevelop's own
         projects, which are Sdk="LibreWPF.Sdk" and reference the OpenAvalon closure
         (ICSharpCode.AvalonEdit.LibreWPF, Dirkster.AvalonDock.*, ...). Resolved from this
         repository the paths below are what OpenDevelop uses itself: the provider feed for the
         LibreWPF/ProGPU packages, and OpenDevelop's synced copy of the rest (produced by
         sync-openavalon-feed.ps1). Without them restore fails with NU1101/NU1605 before any
         compatibility problem can be observed. Sibling layout assumed, like Stride's
         nuget.config. -->
    <add key="librewpf-local" value="../../openavalon/artifacts/local-feed" />
    <add key="opendevelop-openavalon" value="../../OpenDevelop/artifacts/openavalon-feed" />
    <!-- The same closure is also available from LeXtudio's GitHub Packages, which is where CI restores it from (as OpenDevelop's
         own CI does): give the job `packages: read` and set NuGetPackageSourceCredentials_lextudio_github to
         Username=<actor>;Password=<token>;ValidAuthenticationTypes=Basic. A developer's machine uses the two local copies above and
         needs no token. Keep this key free of dashes: NuGet builds the credential variable name from it. -->
    <add key="lextudio_github" value="https://nuget.pkg.github.com/lextudio/index.json" />
  </packageSources>
  <!-- Source mapping keeps the GitHub source (which needs a token) to the packages it is for; everything else comes from nuget.org
       or the .NET engineering feed as before. A package that matches several patterns is resolved from the sources of the longest
       match, and from the union of the sources that share it, so the local copies and GitHub Packages are interchangeable. -->
  <packageSourceMapping>
    <packageSource key="Nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="*" />
    </packageSource>
    <packageSource key="lextudio_github">
      <package pattern="Dirkster.AvalonDock.Core" />
      <package pattern="Dirkster.AvalonDock.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Serializer.Xml" />
      <package pattern="Dirkster.AvalonDock.Themes.VS.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Themes.VS2013.LibreWPF" />
      <package pattern="ICSharpCode.AvalonEdit.LibreWPF" />
      <package pattern="LeXtudio.Wpf.Toolkit" />
      <package pattern="LeXtudio.WinUISurface" />
      <package pattern="LeXtudio.DevFlow.Agent.Core" />
      <package pattern="LeXtudio.DevFlow.Agent.LibreWpf" />
      <package pattern="Microsoft.VisualStudio.CoreUtility" />
      <package pattern="Microsoft.VisualStudio.Text.Data" />
      <package pattern="Microsoft.VisualStudio.Text.Logic" />
      <package pattern="Microsoft.VisualStudio.Text.UI" />
      <package pattern="LeXtudio.SharpDbg.Cli" />
      <package pattern="LeXtudio.SharpDbg.AndroidAgent" />
      <package pattern="WpfHotReload.Runtime" />
      <package pattern="LibGhostty.Net" />
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
    <packageSource key="librewpf-local">
      <package pattern="Dirkster.AvalonDock.Core" />
      <package pattern="Dirkster.AvalonDock.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Serializer.Xml" />
      <package pattern="Dirkster.AvalonDock.Themes.VS.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Themes.VS2013.LibreWPF" />
      <package pattern="ICSharpCode.AvalonEdit.LibreWPF" />
      <package pattern="LeXtudio.Wpf.Toolkit" />
      <package pattern="LeXtudio.WinUISurface" />
      <package pattern="LeXtudio.DevFlow.Agent.Core" />
      <package pattern="LeXtudio.DevFlow.Agent.LibreWpf" />
      <package pattern="Microsoft.VisualStudio.CoreUtility" />
      <package pattern="Microsoft.VisualStudio.Text.Data" />
      <package pattern="Microsoft.VisualStudio.Text.Logic" />
      <package pattern="Microsoft.VisualStudio.Text.UI" />
      <package pattern="LeXtudio.SharpDbg.Cli" />
      <package pattern="LeXtudio.SharpDbg.AndroidAgent" />
      <package pattern="WpfHotReload.Runtime" />
      <package pattern="LibGhostty.Net" />
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
    <packageSource key="opendevelop-openavalon">
      <package pattern="Dirkster.AvalonDock.Core" />
      <package pattern="Dirkster.AvalonDock.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Serializer.Xml" />
      <package pattern="Dirkster.AvalonDock.Themes.VS.LibreWPF" />
      <package pattern="Dirkster.AvalonDock.Themes.VS2013.LibreWPF" />
      <package pattern="ICSharpCode.AvalonEdit.LibreWPF" />
      <package pattern="LeXtudio.Wpf.Toolkit" />
      <package pattern="LeXtudio.WinUISurface" />
      <package pattern="LeXtudio.DevFlow.Agent.Core" />
      <package pattern="LeXtudio.DevFlow.Agent.LibreWpf" />
      <package pattern="Microsoft.VisualStudio.CoreUtility" />
      <package pattern="Microsoft.VisualStudio.Text.Data" />
      <package pattern="Microsoft.VisualStudio.Text.Logic" />
      <package pattern="Microsoft.VisualStudio.Text.UI" />
      <package pattern="LeXtudio.SharpDbg.Cli" />
      <package pattern="LeXtudio.SharpDbg.AndroidAgent" />
      <package pattern="WpfHotReload.Runtime" />
      <package pattern="LibGhostty.Net" />
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
