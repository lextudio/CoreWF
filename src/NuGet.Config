<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="Nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
    <!-- The OpenDevelop addin under src/OpenDevelop.AddIn builds against OpenDevelop's own
         projects, which are Sdk="LibreWPF.Sdk" and reference the OpenAvalon closure
         (ICSharpCode.AvalonEdit.LibreWPF, Dirkster.AvalonDock.*, ...). Resolved from this
         repository the paths below are what OpenDevelop uses itself: the provider feed for the
         LibreWPF/ProGPU packages, and OpenDevelop's synced copy of the rest (produced by
         sync-openavalon-feed.ps1). Without them restore fails with NU1101/NU1605 before any
         compatibility problem can be observed. Sibling layout assumed, like Stride's
         nuget.config. -->
    <add key="librewpf-local" value="../../openavalon/artifacts/local-feed" />
    <add key="opendevelop-openavalon" value="../../OpenDevelop/artifacts/openavalon-feed" />
  </packageSources>
</configuration>
