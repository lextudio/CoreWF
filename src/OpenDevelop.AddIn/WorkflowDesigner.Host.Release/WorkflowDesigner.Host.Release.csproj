<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Workflow Designer's child host built against an INSTALLED OpenDevelop: the protocol libraries
       (ICSharpCode.Designer.Remote / .Server) are taken, as built, from the OpenDevelop release at OpenDevelopHostBin
       instead of from its source tree, so the protocol is exactly the one that release speaks. The host runs on the
       same runtime as the IDE (net11), like the designer hosts OpenDevelop itself ships. Compiles the same sources as
       ../WorkflowDesigner.Host/WorkflowDesigner.Host.csproj, which stays the project for the OpenDevelop checkout. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WorkflowDesigner.Host</AssemblyName>
    <RootNamespace>WorkflowDesigner.Host</RootNamespace>
    <!-- Started as "dotnet exec WorkflowDesigner.Host.dll" by the add-in, never through an apphost (which would also make it architecture-specific). -->
    <UseAppHost>false</UseAppHost>
    <OpenDevelopDistributionBuild>true</OpenDevelopDistributionBuild>
  </PropertyGroup>
  <Import Project="..\AddInDeploy.props" />
  <ItemGroup>
    <Compile Include="..\WorkflowDesigner.Host\*.cs" />
    <Compile Include="..\WorkflowDesigner.Host\Properties\*.cs" />
  </ItemGroup>
  <PropertyGroup>
    <_ReleaseProtocolDir>$(OpenDevelopHostBin)AddIns/DisplayBindings/WpfDesign/Host/</_ReleaseProtocolDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ICSharpCode.Designer.Remote" HintPath="$(_ReleaseProtocolDir)ICSharpCode.Designer.Remote.dll" />
    <Reference Include="ICSharpCode.Designer.Server" HintPath="$(_ReleaseProtocolDir)ICSharpCode.Designer.Server.dll" />
    <ProjectReference Include="../../UiPath.Workflow/UiPath.Workflow.csproj" />
    <!-- What the two protocol libraries need at run time, at the versions that release was built with. -->
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynPackageVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RoslynPackageVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="$(RoslynPackageVersion)" />
  </ItemGroup>
  <Target Name="WorkflowDesignerRequireHost" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(_ReleaseProtocolDir)ICSharpCode.Designer.Server.dll')"
           Text="Set OpenDevelopHostBin (with a trailing slash) to an OpenDevelop release or installation: '$(_ReleaseProtocolDir)ICSharpCode.Designer.Server.dll' was not found." />
  </Target>
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup><HostOutput Include="$(TargetDir)**" /></ItemGroup>
    <Copy SourceFiles="@(HostOutput)" SkipUnchangedFiles="true" DestinationFiles="@(HostOutput->'$(WorkflowDesignerDeployDir)Host/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
