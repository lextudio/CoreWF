<Project>
  <!-- Where the Workflow Designer add-in and its child host are deployed.
       A normal build deploys into the OpenDevelop checkout's AddIns folder (what the IDE and the
       integration suites load). A distribution build (-p:OpenDevelopDistributionBuild=true, used to
       produce the .odaddin release package) deploys into this repository's own bin/odaddin-output
       instead, so the package is made from its own output and never from, or into, the host tree.
       The add-in and WorkflowDesigner.Host both import this file so they agree on the folder. -->
  <PropertyGroup>
    <WorkflowDesignerDeployDir Condition="'$(WorkflowDesignerDeployDir)' == '' And '$(OpenDevelopDistributionBuild)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)bin/odaddin-output/'))</WorkflowDesignerDeployDir>
    <WorkflowDesignerDeployDir Condition="'$(WorkflowDesignerDeployDir)' == ''">$(OpenDevelopRoot)AddIns/DisplayBindings/WorkflowDesigner/</WorkflowDesignerDeployDir>
  </PropertyGroup>
  <!-- The Addin SDK trims an add-in's output by OpenDevelop.host-assemblies.txt, the names of the host's own assemblies.
       OpenDevelop releases up to v5.9.1 do not ship it (later ones write it at the application root). When the host
       directory (OpenDevelopHostBin, with a trailing slash) has none, use the copy in this repository, taken from v5.9.1;
       a host that ships its own list is always preferred. Refresh the copy when a newer host adds assemblies. -->
  <PropertyGroup>
    <OpenDevelopHostManifest Condition="'$(OpenDevelopHostManifest)' == '' And '$(OpenDevelopHostBin)' != '' And !Exists('$(OpenDevelopHostBin)OpenDevelop.host-assemblies.txt')">$(MSBuildThisFileDirectory)OpenDevelop.host-assemblies.txt</OpenDevelopHostManifest>
  </PropertyGroup>
</Project>
