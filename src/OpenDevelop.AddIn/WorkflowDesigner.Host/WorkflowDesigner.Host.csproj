<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><!-- A regular property from a ProjectReference does not propagate; read the same
         OPENDEVELOP_ROOT environment variable here so the hosting OpenDevelop can evaluate this
         host too (see WorkflowDesigner.csproj). -->
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == '' And '$(OPENDEVELOP_ROOT)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OPENDEVELOP_ROOT)'))</OpenDevelopRoot>
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../UnoDevelop/externals/OpenDevelop/'))</OpenDevelopRoot><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><OpenDevelopAddin>true</OpenDevelopAddin><OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Remote/Designer.Remote.csproj" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Server/Designer.Server.csproj" />
    <ProjectReference Include="../../UiPath.Workflow/UiPath.Workflow.csproj" />
	<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynPackageVersion)" />
	<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RoslynPackageVersion)" />
	<PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="$(RoslynPackageVersion)" />
  </ItemGroup>
  <Target Name="DeployToAddIns" AfterTargets="Build"><ItemGroup><HostOutput Include="$(TargetDir)**" /></ItemGroup><Copy SourceFiles="@(HostOutput)" SkipUnchangedFiles="true" DestinationFiles="@(HostOutput->'$(OpenDevelopRoot)AddIns\DisplayBindings\WorkflowDesigner\Host\%(RecursiveDir)%(Filename)%(Extension)')" /></Target>
</Project>
