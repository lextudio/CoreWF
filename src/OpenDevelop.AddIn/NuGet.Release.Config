<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The release build of the add-in (WorkflowDesigner.Release, WorkflowDesigner.Host.Release) needs nothing but
       nuget.org: the host's assemblies come from an unpacked OpenDevelop release and the Addin SDK from the same
       installation. The repository's src/NuGet.Config also lists local OpenAvalon feeds, which exist only next to an
       OpenDevelop checkout and make a clean machine's restore fail. Use with -p:RestoreConfigFile=<this file>. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
