<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <!-- The OPENDEVELOP_ROOT environment variable reaches evaluations this project cannot pass a
         -p: to, such as the hosting OpenDevelop reading StartArguments (the integration suite's
         parent host). Same fallback as the Stride and MAUI add-ins. -->
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == '' And '$(OPENDEVELOP_ROOT)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OPENDEVELOP_ROOT)'))</OpenDevelopRoot>
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../UnoDevelop/externals/OpenDevelop/'))</OpenDevelopRoot>
    <!-- An external WorkflowDesigner is debugged in an installed OpenDevelop through the Addin
         SDK's -addindir: launch, never by copying its output into the application bundle. -->
    <OpenDevelopHostBin Condition="'$(OpenDevelopHostBin)' == '' And '$(OPENDEVELOP_APP_PATH)' != ''">$([System.IO.Path]::GetDirectoryName('$(OPENDEVELOP_APP_PATH)'))/</OpenDevelopHostBin>
    <OpenDevelopDebugDevFlowPort Condition="'$(OpenDevelopDebugDevFlowPort)' == '' And '$(OPENDEVELOP_ADDIN_TEST_DEVFLOW_PORT)' != ''">$(OPENDEVELOP_ADDIN_TEST_DEVFLOW_PORT)</OpenDevelopDebugDevFlowPort>
    <!-- OpenDevelopAppFixture sets OD_TEST_MODE only for integration-test host processes. -->
    <OpenDevelopDebugDevFlowPort Condition="'$(OpenDevelopDebugDevFlowPort)' == '' And '$(OD_TEST_MODE)' == '1'">9301</OpenDevelopDebugDevFlowPort>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net11.0-windows</TargetFramework>
    <!-- The published LibreWPF closure ships lib/net10.0 only; LibreWPF.Sdk derives these folders from the TargetFramework, so pin them back (same block as OpenDevelop's Directory.Build.props). -->
    <_ProGpuWpfManagedTransportRuntimeTfm>net10.0</_ProGpuWpfManagedTransportRuntimeTfm>
    <_ProGpuWpfCanonicalWinFormsRuntimeTfm>net10.0</_ProGpuWpfCanonicalWinFormsRuntimeTfm>
    <_ProGpuWpfPortableWinFormsCompatRuntimeTfm>net10.0</_ProGpuWpfPortableWinFormsCompatRuntimeTfm>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <AssemblyName>ICSharpCode.WorkflowDesigner</AssemblyName>
    <RootNamespace>ICSharpCode.WorkflowDesigner</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="..\AddInDeploy.props" />
  <PropertyGroup>
    <OutputPath>$(WorkflowDesignerDeployDir)</OutputPath>
  </PropertyGroup>
  <Import Project="$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props" Condition="Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props')" />
  <ItemGroup>
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Base/Project/ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Core/Project/ICSharpCode.Core.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/ICSharpCode.SharpDevelop.Widgets/Project/ICSharpCode.SharpDevelop.Widgets.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Libraries/AvalonEdit/ICSharpCode.AvalonEdit/ICSharpCode.AvalonEdit.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Remote/Designer.Remote.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Shell/Designer.Shell.csproj" Private="false" />
    <ProjectReference Include="..\WorkflowDesigner.Host\WorkflowDesigner.Host.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" />
    <!-- DevFlow attributes are development/test instrumentation, matching the other designer
         addins; the runtime agent is already supplied by the OpenDevelop Debug host.
         Keep this at the host's own pin (OpenDevelop's Directory.Packages.props): the attributes
         are discovered by the host's agent, so a lower compile-time version loads a second copy
         into the same process. -->
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" Version="0.3.1" />
    <!-- The referenced OpenDevelop projects require these BCL extension packages at the versions
         below; without an explicit floor the transitive graph below this project still resolves
         the older patch releases and restore fails with NU1605 (warnings are errors here). They
         are compile-time floors only: the host process already provides every one of them. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="11.0.0-rc.2.26504.105" ExcludeAssets="runtime" />
    <PackageReference Include="System.Formats.Nrbf" Version="11.0.0-rc.2.26504.105" ExcludeAssets="runtime" />
    <PackageReference Include="System.IO.Packaging" Version="11.0.0-rc.2.26504.105" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Permissions" Version="11.0.0-rc.2.26504.105" ExcludeAssets="runtime" />
    <PackageReference Include="System.Windows.Extensions" Version="11.0.0-rc.2.26504.105" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup><None Include="WorkflowDesigner.addin" /></ItemGroup>
  <ItemGroup>
    <!-- Toolbar icons in the VS2017 Image Library's own pre-converted XAML vector format, embedded
         into THIS assembly rather than added to the host's ICSharpCode.Core.Presentation resources:
         they are needed only by this addin, which ships from its own repository, so the host must
         neither carry them nor be rebuilt to add one. Same arrangement ILSpyAddIn uses for its
         member icons - see its Icons/ folder and VsIconLoader.cs, which WorkflowIcons mirrors. -->
    <EmbeddedResource Include="Icons\*.xaml" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets" Condition="Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets')" />
  <!-- The referenced OpenDevelop projects drag the host's own payload into this output: native
       runtimes, satellite resources, symbols and tools. The host process already provides all of it
       and a .odaddin is managed AnyCPU code only, so a distribution build drops it before PackOdAddin
       zips the folder. The child host under Host/ is self-contained and is left alone. -->
  <Target Name="WorkflowDesignerPruneHostPayload" AfterTargets="Build" BeforeTargets="PackOdAddin" Condition="'$(OpenDevelopDistributionBuild)' == 'true'">
    <ItemGroup>
      <_WfHostPayloadFile Include="$(OutputPath)*.pdb;$(OutputPath)Cliclick*" />
      <_WfHostPayloadFile Include="$(OutputPath)*/*.resources.dll" />
    </ItemGroup>
    <ItemGroup>
      <_WfHostPayloadDirectory Include="$(OutputPath)runtimes" />
      <_WfHostPayloadDirectory Include="@(_WfHostPayloadFile->'%(RootDir)%(Directory)')" Condition="'%(Filename)' != ''" />
    </ItemGroup>
    <Delete Files="@(_WfHostPayloadFile)" />
    <RemoveDir Directories="$(OutputPath)runtimes" />
  </Target>
</Project>
